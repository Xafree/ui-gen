{
  "name": "uigen-sidecar",
  "version": "1.0.0",
  "description": "UIGEN capture service: installs npm UI libraries and captures their rendered DOM in Chromium",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "7.3.11",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/browser": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "pixelmatch": "7.2.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
